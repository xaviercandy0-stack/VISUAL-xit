local function bind(sig, fn)
    local c = sig:Connect(fn); table.insert(Connections, c); return c
end

--=====================================================================
--  UI HELPERS
--=====================================================================
local THEME = {
    bg      = Color3.fromRGB(12, 12, 16),
    panel   = Color3.fromRGB(20, 20, 26),
    row     = Color3.fromRGB(27, 27, 35),
    accent  = Color3.fromRGB(255, 106, 0),
    accent2 = Color3.fromRGB(255, 0, 90),
    text    = Color3.fromRGB(240, 240, 246),
    dim     = Color3.fromRGB(145, 145, 160),
    on      = Color3.fromRGB(0, 214, 140),
    off     = Color3.fromRGB(58, 58, 70),
}

local function corner(i, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = i; return c
end
local function stroke(i, col, th, tr)
    local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = th or 1
    s.Transparency = tr or 0; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = i; return s
end
local function gradient(i, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2); g.Rotation = rot or 0; g.Parent = i; return g
end
local function padding(i, n)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, n); p.PaddingRight = UDim.new(0, n)
    p.PaddingTop = UDim.new(0, n);  p.PaddingBottom = UDim.new(0, n)
    p.Parent = i; return p
end
local function newGui(name, order)
    local g = Instance.new("ScreenGui")
    g.Name = name; g.ResetOnSpawn = false; g.IgnoreGuiInset = true
    g.DisplayOrder = order; g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    g.Parent = PlayerGui
    return g
end

