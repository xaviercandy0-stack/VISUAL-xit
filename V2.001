bubble = new("TextButton", {
    Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0, 16, 0.5, -27),
    BackgroundColor3 = COL_BG, Text = "N", Font = Enum.Font.GothamBlack, TextColor3 = COL_ACCENT,
