--==================== REMOTES ====================--
local KEYWORDS = {
    shoot = 6, fire = 5, hit = 5, damage = 6, dmg = 5, bullet = 4, shot = 4,
    kill = 4, attack = 3, raycast = 4, weapon = 2, gun = 2, projectile = 2,
}
local KICK_WORDS = { kick = true, ban = true, anticheat = true, anti_cheat = true,
    detect = true, exploit = true, security = true }
local remotes = {}

local function nameScore(name)
    local n = name:lower()
    local s = 0
    for k, w in pairs(KEYWORDS) do
        if n:find(k) then s = s + w end
    end
    if n:find("recoil") or n:find("sound") or n:find("anim") or n:find("camera") then s = s - 3 end
    return s
end

local function isKickRemote(name)
    local n = name:lower()
    for k in pairs(KICK_WORDS) do
        if n:find(k) then return true end
    end
    return false
end

local function scanRemotes()
    remotes = {}
    for _, root in ipairs({ ReplicatedStorage, ReplicatedFirst, workspace, game:GetService("StarterPack") }) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, obj in ipairs(list) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    table.insert(remotes, { obj = obj, score = nameScore(obj.Name), name = obj.Name })
                end
            end
        end
    end
    table.sort(remotes, function(a, b) return a.score > b.score end)
end

local function argScore(args)
    local s = 0
    for _, v in ipairs(args) do
        local ty = typeof(v)
        if ty == "Instance" then
            if v:IsA("BasePart") then
                s = s + 3
                local p = v.Parent
                if p and p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then s = s + 6 end
            elseif v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then s = s + 7
            elseif v:IsA("Humanoid") then s = s + 5 end
        elseif ty == "Vector3" then s = s + 1
        end
    end
    return s
end

local function recordCall(remote, args)
    local sc = argScore(args) + nameScore(remote.Name)
    if sc < 3 then return 0 end
    table.insert(calls, { remote = remote, args = args, t = tick(), score = sc })
    while #calls > 25 do table.remove(calls, 1) end
    return sc
end

local function bestShot()
    local best, bestSc = nil, 0
    for _, c in ipairs(calls) do
        local age = tick() - c.t
        if age < 180 and c.remote and c.remote.Parent then
            local sc = c.score - age * 0.05
            if sc > bestSc then best, bestSc = c, sc end
        end
    end
    return best
end

--==================== OBJETIVOS ====================--
local function getTargets(range)
    local list = {}
    local myChar = LP.Character
    local myRoot = myChar and rootOf(myChar)
    if not myRoot then return list end

    local function add(char, name, player)
        if not isAlive(char) or char == myChar then return end
        local r = rootOf(char)
        if not r then return end
        local d = dist(myRoot.Position, r.Position)
        if range and d > range then return end
        table.insert(list, {
            char = char, root = r, head = char:FindFirstChild("Head") or r,
            hum = char:FindFirstChildOfClass("Humanoid"), player = player, name = name, dist = d,
        })
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then add(p.Character, p.Name, p) end
    end
    if state.bots then
        for _, m in ipairs(botCache) do add(m, m.Name, nil) end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function bestTarget()
    return getTargets(cfg.shootRange)[1]
end

--==================== HITBOXES ====================--
local function applyHitbox(part, on)
    if not part or not part.Parent then return end
    if on then
        if not part:GetAttribute("NM_ORIG") then
            part:SetAttribute("NM_ORIG", part.Size)
            part.Size = part.Size * cfg.hitboxScale
        end
    else
        local s = part:GetAttribute("NM_ORIG")
        if s then
            pcall(function() part.Size = s end)
            part:SetAttribute("NM_ORIG", nil)
        end
    end
end

local function setHitboxes(on)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    applyHitbox(part, on)
                end
            end
        end
    end
    for _, m in ipairs(botCache) do
        for _, part in ipairs(m:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                applyHitbox(part, on)
            end
        end
    end
end

