local function bindChar(char)
    local hum = char:WaitForChild("Humanoid", 8)
    if not hum then return end
    hum.WalkSpeed = cfg.walkSpeed
    hum.JumpPower = cfg.jumpPower
    hum.UseJumpPower = true
    refreshSpoof()
    if state.invisible then setInvisible(true) end
    if state.fly or state.flyCreepy then startFly() end
end
conn(LP.CharacterAdded, function(c)
    task.wait(0.5)
    hidden = {}
    lastHit = {}
    bindChar(c)
end)
if LP.Character then bindChar(LP.Character) end

task.spawn(function()
    while mainGui.Parent do
        local list = {}
        if state.bots then
            for _, m in ipairs(workspace:GetChildren()) do
                if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(m) then
                    table.insert(list, m)
                end
            end
        end
        botCache = list
        task.wait(0.7)
    end
end)

conn(RunService.Heartbeat, function()
    local now = tick()
    bucket = math.min(bucketMax, bucket + (now - lastRefill) * (shield.rate or 10))
    lastRefill = now
end)

conn(RunService.RenderStepped, function(dt)
    if not Camera or not Camera.Parent then Camera = workspace.CurrentCamera end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local myRoot = char and rootOf(char)

    if crosshair then
        crosshair.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
    if fovCircle then
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        fovCircle.Radius = cfg.fov / 2
    end

    if (state.fly or state.flyCreepy) and flyRoot and flyRoot.Parent then
        local cf = Camera.CFrame
        local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if fwd.Magnitude > 0.01 then fwd = fwd.Unit else fwd = Vector3.zero end
        local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
        if right.Magnitude > 0.01 then right = right.Unit else right = Vector3.zero end

        local dir = Vector3.zero
        local move = hum and hum.MoveDirection or Vector3.zero
        if move.Magnitude > 0.05 then dir = dir + move.Unit end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end

        local vert = flyUp - flyDown
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert = vert + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vert = vert - 1 end

        if state.flyAnchored then
            local delta = dir * cfg.flySpeed * dt + Vector3.new(0, vert * cfg.flySpeed * dt, 0)
            if dir.Magnitude > 0.01 or vert ~= 0 then
                local pos = flyRoot.Position + delta
                flyRoot.CFrame = CFrame.new(pos) * (flyRoot.CFrame - flyRoot.Position)
            end
            flyRoot.AssemblyLinearVelocity = Vector3.zero
        elseif flyBV then
            flyBV.Parent = flyRoot
            local v = dir * cfg.flySpeed + Vector3.new(0, vert * cfg.flySpeed, 0)
            if v.Magnitude < 0.1 then v = Vector3.new(0, 1, 0) end
            flyBV.Velocity = v
        end
    end

    if state.noclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    updateESP()
end)

conn(UserInputService.JumpRequest, function()
    if state.infJump and LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- LOOP DE ATAQUE
task.spawn(function()
    while mainGui.Parent do
        local attacking = state.flyCreepy or state.magicBullets or state.autoShoot
        if attacking then
            local list = getTargets(cfg.shootRange)
            if #list > 0 then
                local step_ = (state.flyCreepy or state.autoShoot) and cfg.cadence or math.max(cfg.cadence, 0.13)
                for i = 1, #list do
                    if not (state.flyCreepy or state.magicBullets or state.autoShoot) then break end
                    local t = list[i]
                    aimAt(t.head.Position, state.redAll and nil or 1)
                    shootAt(t)
                    task.wait(step_ * (0.8 + math.random() * 0.4))
                end
            end
        end
        task.wait(0.02)
    end
end)

-- REFRESCO HITBOXES / ROJO
task.spawn(function()
    while mainGui.Parent do
        if state.flyCreepy or state.magicBullets then setHitboxes(true) end
        if state.redAll then
            refreshRed()
            local t = bestTarget()
            if t then aimAt(t.head.Position, 1) end
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    while mainGui.Parent do
        task.wait(1)
        if not LP.Parent then
            if state.autoRejoin then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId) end)
            end
            task.wait(2)
        end
    end
end)

task.spawn(function()
    while mainGui.Parent do
        task.wait(3)
        if shield.master and shield.watchHooks then
            local ok, alive = pcall(function()
                local mt = getrawmetatable(game)
                return mt.__namecall == hookNamecall and mt.__index == hookIndex
            end)
            if ok and not alive then installHooks() end
        end
        if shield.master then refreshSpoof() end
    end
end)

conn(UserInputService.InputBegan, function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        root.Visible = not root.Visible
        bubble.Visible = not root.Visible
    end
end)

getgenv().NMODS_DESTROY = function()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    clearESP()
    clearRed()
    setHitboxes(false)
    if crosshair then pcall(function() crosshair:Remove() end) end
    if fovCircle then pcall(function() fovCircle:Remove() end) end
    stopFly()
    setInvisible(false)
    if LP.Character then
        for _, p in ipairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then
            h.WalkSpeed = 16
            h.JumpPower = 50
        end
    end
    Lighting.Brightness = 1.6
    Lighting.GlobalShadows = true
    pcall(function() mainGui:Destroy() end)
    pcall(function() loadGui:Destroy() end)
    getgenv().NMODS_DESTROY = nil
end

--==================== ARRANQUE ====================--
task.spawn(function()
    local ok, err = pcall(function()
        step("Verificando servicios...", 0.1, 0.3)
        step("Comprobando juego...", 0.2, 0.25)
        if game.PlaceId ~= TARGET_PLACE then
            status.Text = "AVISO: no estas en Free Fire Zone"
            task.wait(0.7)
        end
        step("Escaneando remotes...", 0.35, 0.35)
        scanRemotes()
        step("Instalando hooks...", 0.5, 0.3)
        installHooks()
        step("Preparando hitboxes...", 0.65, 0.3)
        step("Construyendo interfaz...", 0.8, 0.3)
        step("Listo.", 1, 0.3)

        tw(loadBg, { BackgroundTransparency = 1 }, 0.35)
        tw(logo, { TextTransparency = 1 }, 0.3)
        tw(barBg, { BackgroundTransparency = 1 }, 0.3)
        tw(status, { TextTransparency = 1 }, 0.3)
        tw(pctLabel, { TextTransparency = 1 }, 0.3)
        task.wait(0.4)
        loadGui:Destroy()

        root.Size = UDim2.fromOffset(320, 390)
        tw(root, { Size = UDim2.fromOffset(352, 430) }, 0.28, Enum.EasingStyle.Back)
        task.wait(0.3)
        switchTab(1)
        notify("NMODS v" .. VERSION .. " listo", true)
    end)
    if not ok then warn("[NMODS] ERROR: " .. tostring(err)) end
end)
