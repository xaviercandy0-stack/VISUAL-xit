})
new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bubble })
local bubStroke = new("UIStroke", { Color = COL_ACCENT, Thickness = 2, Parent = bubble })
bubble.MouseButton1Click:Connect(function()
    bubble.Visible = false
    root.Visible = true
    root.Size = UDim2.fromOffset(320, 390)
    tw(root, { Size = UDim2.fromOffset(352, 430) }, 0.25, Enum.EasingStyle.Back)
end)

if Drawing then
    pcall(function()
        crosshair = Drawing.new("Circle")
        crosshair.Radius = 3
        crosshair.Thickness = 1.5
        crosshair.Filled = true
        crosshair.Color = Color3.fromRGB(255, 120, 50)
        crosshair.Visible = true

        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 1
        fovCircle.NumSides = 64
        fovCircle.Color = Color3.fromRGB(255, 120, 50)
        fovCircle.Visible = false
    end)
