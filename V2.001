local function createGui(name, order)
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = order
    local getters = {}
    if gethui then table.insert(getters, gethui) end
    table.insert(getters, function() return CoreGui end)
    table.insert(getters, function() return LP:WaitForChild("PlayerGui", 10) end)
    for _, g in ipairs(getters) do
        local ok, container = pcall(g)
        if ok and container then
            if pcall(function() gui.Parent = container end) and gui.Parent then return gui end
        end
    end
    return gui
end

--==================== SHIELD ====================--
local shield = {
    master = true, hideSpeed = true, hideJump = true, rateLimit = true,
    antiKick = true, antiRubber = true, ramp = true, watchHooks = true, rate = 10,
}
local bucket, bucketMax, lastRefill = 8, 8, tick()
local spoof, spoofedHum, bypass = {}, nil, false
local hookNamecall, hookIndex

local function realIndex(inst, key)
    bypass = true
    local ok, v = pcall(function() return inst[key] end)
    bypass = false
    return ok and v or nil
end

local function refreshSpoof()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if spoofedHum and spoofedHum ~= hum then spoof[spoofedHum] = nil end
    spoofedHum = hum
    if not hum then return end
    if not shield.master then spoof[hum] = nil return end
    spoof[hum] = spoof[hum] or {}
    spoof[hum].WalkSpeed = shield.hideSpeed and 16 or nil
    spoof[hum].JumpPower = shield.hideJump and 50 or nil
end

local function rampSpeed(target)
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if not (shield.master and shield.ramp) then hum.WalkSpeed = target return end
    local cur = realIndex(hum, "WalkSpeed") or 16
    task.spawn(function()
        for i = 1, 8 do
            if not hum.Parent then return end
            hum.WalkSpeed = cur + (target - cur) * (i / 8)
            task.wait(0.05)
        end
    end)
end

local function rampJump(target)
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if not (shield.master and shield.ramp) then hum.JumpPower = target return end
    local cur = realIndex(hum, "JumpPower") or 50
    task.spawn(function()
        for i = 1, 8 do
            if not hum.Parent then return end
            hum.JumpPower = cur + (target - cur) * (i / 8)
            task.wait(0.05)
        end
    end)
end

--==================== ESTADO ====================--
local state = {
    flyCreepy = false, magicBullets = false, autoShoot = false, redAll = false,
    invisible = false, fly = false, esp = false, boxes = true, names = true,
    distance = true, health = true, tracers = false, bots = true, noclip = false,
    infJump = false, fullbright = false, crosshair = true, fovCircle = false,
    stealth = true, autoRejoin = true, flyAnchored = false, inject = false,
}
local cfg = {
    flySpeed = 70, walkSpeed = 26, jumpPower = 65, fov = 300,
    shootRange = 500, hitboxScale = 6, cadence = 0.09, damage = 100,
}
local connections, espCache, hidden, botCache, reds = {}, {}, {}, {}, {}
local calls, lastHit, manualRemote = {}, {}, nil
local flyUp, flyDown = 0, 0
local aimTarget = nil

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() o[k] = v end) end
    if parent then o.Parent = parent end
    return o
end

local function tw(obj, props, time, style, dir)
    local ok, t = pcall(function()
        local t = TweenService:Create(obj,
            TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
        t:Play()
        return t
    end)
    return ok and t or nil
end

local function conn(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

local function isAlive(char)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0 and char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function rootOf(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
end

local function dist(a, b)
    local ok, d = pcall(function() return (a - b).Magnitude end)
    return ok and d or 99999
end

