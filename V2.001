        end
    end
end)
button(pages[3], "Teleport al enemigo mas cercano", function()
    local t = bestTarget()
    local myRoot = LP.Character and rootOf(LP.Character)
    if t and myRoot then
        myRoot.CFrame = t.root.CFrame * CFrame.new(0, 2, 4)
        notify("TP -> " .. t.name, true)
    else
        notify("Sin objetivos", false)
    end
end)

