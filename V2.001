end)
toggle(pages[2], "Cajas", nil, true, function(v) state.boxes = v end)
toggle(pages[2], "Nombres", nil, true, function(v) state.names = v end)
toggle(pages[2], "Distancia", nil, true, function(v) state.distance = v end)
toggle(pages[2], "Vida", nil, true, function(v) state.health = v end)
