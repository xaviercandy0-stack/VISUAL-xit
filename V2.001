local function clearRed()
    for _, h in pairs(reds) do pcall(function() h:Destroy() end) end
    reds = {}
end

local function refreshRed()
    if not state.redAll then return end
    for _, t in ipairs(getTargets(cfg.shootRange)) do
        if not reds[t.char] then
            local ok, h = pcall(function()
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 30, 30)
                hl.FillTransparency = 0.45
                hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = t.char
                hl.Parent = t.char
                return hl
            end)
            if ok then reds[t.char] = h end
        end
    end
end

--==================== DISPARO ====================--
local function rewrite(args, t)
    local out = {}
    for i, v in ipairs(args) do
        local ty = typeof(v)
        if ty == "Instance" then
            if v:IsA("BasePart") then out[i] = t.head
            elseif v:IsA("Model") then out[i] = t.char
            elseif ty == "Humanoid" then out[i] = t.hum
            else out[i] = v end
        elseif ty == "Vector3" then out[i] = t.head.Position
        elseif ty == "CFrame" then out[i] = t.head.CFrame
        else out[i] = v end
    end
    return out
end

local function fireRemote(t)
    if manualRemote then
        pcall(function() manualRemote:FireServer(t.head) end)
        return
    end
    local shot = bestShot()
    if shot then
        pcall(function() shot.remote:FireServer(unpack(rewrite(shot.args, t))) end)
    end
end

local function click()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(
            Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2, 0, true, game, 1)
        task.wait(0.008)
        VirtualInputManager:SendMouseButtonEvent(
            Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2, 0, false, game, 1)
    end)
    if mouse1click then pcall(mouse1click) end
end

local function aimAt(pos, factor)
    local camPos = Camera.CFrame.Position
    local goal = CFrame.lookAt(camPos, pos)
    if factor then
        Camera.CFrame = Camera.CFrame:Lerp(goal, factor)
    else
        Camera.CFrame = goal
    end
end

local function shootAt(t)
    if not t then return end
    local now = tick()
    if lastHit[t.char] and now - lastHit[t.char] < 0.05 then return end
    lastHit[t.char] = now

    aimAt(t.head.Position, 1)
    if state.inject then fireRemote(t) end
    if shield.master and shield.rateLimit then
        if bucket < 1 then return end
        bucket = bucket - 1
    end
    click()
end

--==================== ANTI-KICK ====================--
local rejoinLock = false
local function rejoin(reason)
    if rejoinLock then return end
    rejoinLock = true
    notify("Rejoin: " .. tostring(reason), false)
    if queue_on_teleport then pcall(function() queue_on_teleport(LOADER) end) end
    task.wait(0.15)
    local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
    if not ok then pcall(function() TeleportService:Teleport(game.PlaceId, LP) end) end
end

--==================== HOOKS ====================--
local function installHooks()
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        local oldIndex = mt.__index
        setreadonly(mt, false)

        hookNamecall = function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" and self == LP and shield.master and shield.antiKick then
                task.spawn(function() rejoin("Kick()") end)
            end
            if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance"
                and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
                local args = { ... }
                if shield.master and shield.antiKick and isKickRemote(self.Name) then
                    task.spawn(function() rejoin(self.Name) end)
                end
                recordCall(self, args)
            end
            return oldNamecall(self, ...)
        end

        hookIndex = function(self, key)
            if not bypass and type(key) == "string" then
                local s = spoof[self]
                if s then
                    local v = s[key]
                    if v ~= nil then return v end
                end
            end
            return oldIndex(self, key)
        end

        if newcclosure then
            hookNamecall = newcclosure(hookNamecall)
            hookIndex = newcclosure(hookIndex)
        end
        mt.__namecall = hookNamecall
        mt.__index = hookIndex
        setreadonly(mt, true)
    end)
end

--==================== VUELO ====================--
local flyRoot, flyBV, lastFlyPos
local function stopFly()
    if flyRoot then pcall(function() flyRoot.Anchored = false end) flyRoot = nil end
    if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
    flyUp, flyDown, lastFlyPos = 0, 0, nil
end

local function startFly()
    local char = LP.Character
    local root = char and rootOf(char)
    if not root then return end
    stopFly()
    flyRoot = root
    lastFlyPos = root.Position
    if state.flyAnchored then
        root.Anchored = true
    else
        flyBV = Instance.new("BodyVelocity")
        flyBV.Name = "NMODS_FLY"
        flyBV.MaxForce = Vector3.new(4e4, 4e4, 4e4)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end
end

--==================== INVISIBLE ====================--
local function setInvisible(on)
    local char = LP.Character
    if not char then return end
    if on then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("Decal") then
                hidden[d] = d.Transparency
                d.Transparency = 1
                if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 end
            end
        end
    else
        for d, v in pairs(hidden) do
            if d and d.Parent then
                pcall(function()
                    d.Transparency = v
                    if d:IsA("BasePart") then d.LocalTransparencyModifier = v end
                end)
            end
        end
        hidden = {}
    end
end

--==================== ESP ====================--
local function clearESP()
    for _, set in pairs(espCache) do
        for _, d in pairs(set) do pcall(function() d:Remove() end) end
    end
    espCache = {}
end

local function makeESP()
    if not Drawing then return end
    for _, t in ipairs(getTargets()) do
        local key = t.player and t.player.Name or tostring(t.char)
        if not espCache[key] then
            local ok, set = pcall(function()
                local s = {
                    box = Drawing.new("Square"), name = Drawing.new("Text"),
                    dist = Drawing.new("Text"), health = Drawing.new("Line"),
                }
                s.name.Size = 14
                s.name.Center = true
                s.name.Outline = true
                s.dist.Size = 12
                s.dist.Center = true
                s.dist.Outline = true
                return s
            end)
            if ok then espCache[key] = set end
        end
    end
end

local function updateESP()
    if not state.esp or not Drawing then
        if next(espCache) then clearESP() end
        return
    end
    local seen = {}
    for _, t in ipairs(getTargets()) do
        local key = t.player and t.player.Name or tostring(t.char)
        seen[key] = true
        local set = espCache[key]
        if set then
            local ok = pcall(function()
                local hp = Camera:WorldToViewportPoint(t.head.Position)
                local hr = Camera:WorldToViewportPoint(t.root.Position)
                if hp.Z > 0 and hr.Z > 0 then
                    local h = math.abs(hr.Y - hp.Y) * 1.9
                    local w = h * 0.62
                    local x, y = hr.X - w / 2, hp.Y - h * 0.18
                    set.box.Position = Vector2.new(x, y)
                    set.box.Size = Vector2.new(w, h)
                    set.box.Color = Color3.fromRGB(255, 60, 40)
                    set.box.Thickness = 1
                    set.box.Visible = state.boxes

                    set.name.Text = t.name
                    set.name.Position = Vector2.new(hp.X, y - 17)
                    set.name.Color = Color3.fromRGB(255, 255, 255)
                    set.name.Visible = state.names

                    set.dist.Text = string.format("[%d]", math.floor(t.dist))
                    set.dist.Position = Vector2.new(hp.X, y + h + 2)
                    set.dist.Color = Color3.fromRGB(255, 200, 120)
                    set.dist.Visible = state.distance

                    local frac = math.clamp(t.hum.Health / math.max(t.hum.MaxHealth, 1), 0, 1)
                    set.health.From = Vector2.new(x - 4, y + h)
                    set.health.To = Vector2.new(x - 4, y + h - h * frac)
                    set.health.Color = Color3.fromRGB(60, 255, 90):Lerp(Color3.fromRGB(255, 40, 40), 1 - frac)
                    set.health.Thickness = 2
                    set.health.Visible = state.health
                else
                    for _, d in pairs(set) do d.Visible = false end
                end
            end)
            if not ok then
                for _, d in pairs(set) do pcall(function() d:Remove() end) end
                espCache[key] = nil
            end
        end
    end
    for key, set in pairs(espCache) do
        if not seen[key] then
            for _, d in pairs(set) do pcall(function() d:Remove() end) end
            espCache[key] = nil
        end
    end
end

--==================== NOTIFICACIONES ====================--
local notifHolder
local function notify(text, ok)
    if not notifHolder then return end
    local f = new("Frame", {
        Size = UDim2.fromOffset(230, 34), BackgroundColor3 = Color3.fromRGB(18, 20, 26),
        BackgroundTransparency = 0.05, BorderSizePixel = 0, Parent = notifHolder,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = f })
    new("UIStroke", { Color = ok and Color3.fromRGB(60, 220, 120) or Color3.fromRGB(255, 90, 40), Parent = f })
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
        Text = "  " .. tostring(text), TextColor3 = Color3.fromRGB(235, 235, 240), TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    f.Position = UDim2.new(1, 10, 0, 0)
    tw(f, { Position = UDim2.new(0, 0, 0, (#notifHolder:GetChildren() - 1) * 40) }, 0.25)
    task.delay(3, function()
        tw(f, { BackgroundTransparency = 1 }, 0.3)
        tw(f.Position, UDim2.new(1, 10, 0, 0), 0.3)
        task.wait(0.35)
        f:Destroy()
    end)
end
getgenv().NMODS_NOTIFY = notify

--==================== UI ====================--
local COL_BG     = Color3.fromRGB(12, 13, 18)
local COL_PANEL  = Color3.fromRGB(17, 19, 26)
local COL_ACCENT = Color3.fromRGB(255, 92, 30)
local COL_TEXT   = Color3.fromRGB(238, 238, 244)
local COL_SUB    = Color3.fromRGB(140, 143, 158)

local mainGui = createGui("NMODS_PROXY", 5000)

notifHolder = new("Frame", {
    Size = UDim2.fromOffset(240, 220), Position = UDim2.new(1, -250, 0, 14),
    BackgroundTransparency = 1, Parent = mainGui,
})

local root = new("Frame", {
    Size = UDim2.fromOffset(352, 430), Position = UDim2.new(0.5, -176, 0.5, -215),
    BackgroundColor3 = COL_BG, BorderSizePixel = 0, Parent = mainGui,
})
new("UICorner", { CornerRadius = UDim.new(0, 12), Parent = root })
local rootStroke = new("UIStroke", { Color = COL_ACCENT, Thickness = 1.4, Transparency = 0.25, Parent = root })

local uiScale = new("UIScale", { Scale = 1, Parent = root })
local function fitScale()
    local ok, s = pcall(function() return math.clamp(Camera.ViewportSize.X / 460, 0.62, 1) end)
    uiScale.Scale = ok and s or 0.8
end
fitScale()
conn(Camera:GetPropertyChangedSignal("ViewportSize"), fitScale)

local header = new("Frame", {
    Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = COL_PANEL,
    BorderSizePixel = 0, Parent = root,
})
new("UICorner", { CornerRadius = UDim.new(0, 12), Parent = header })
new("Frame", {
    Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14),
    BackgroundColor3 = COL_PANEL, BorderSizePixel = 0, Parent = header,
})
local headGrad = new("UIGradient", {
    Color = ColorSequence.new(Color3.fromRGB(30, 20, 24), Color3.fromRGB(17, 19, 26)), Parent = header,
})
local headLine = new("Frame", {
    Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
    BackgroundColor3 = COL_ACCENT, BorderSizePixel = 0, Parent = header,
})
new("UIGradient", {
    Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 50)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 50, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 20, 90)),
    }), Parent = headLine,
})
task.spawn(function()
    while header.Parent do
        tw(headGrad, { Offset = Vector2.new(1, 0) }, 2.6, Enum.EasingStyle.Linear)
        task.wait(2.6)
        headGrad.Offset = Vector2.new(-1, 0)
    end
end)

new("TextLabel", {
    Size = UDim2.fromOffset(160, 18), Position = UDim2.fromOffset(14, 7),
    BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, Text = "NMODS PROXY",
    TextColor3 = COL_TEXT, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
})
local shieldDot = new("Frame", {
    Size = UDim2.fromOffset(7, 7), Position = UDim2.fromOffset(122, 12),
    BackgroundColor3 = Color3.fromRGB(60, 230, 120), BorderSizePixel = 0, Parent = header,
})
new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = shieldDot })
new("TextLabel", {
    Size = UDim2.fromOffset(200, 12), Position = UDim2.fromOffset(14, 25),
    BackgroundTransparency = 1, Font = Enum.Font.Code, Text = "v" .. VERSION .. "  •  FFZ MAX",
    TextColor3 = COL_SUB, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
})

local dragging, dragStart, startPos
conn(header.InputBegan, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos = root.Position
    end
end)
conn(UserInputService.InputChanged, function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dragStart
        root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
conn(UserInputService.InputEnded, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local TABS = { "COMBATE", "VISUAL", "MOVER", "SHIELD", "MISC" }
local tabBar = new("Frame", {
    Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 50),
    BackgroundColor3 = Color3.fromRGB(20, 22, 29), BorderSizePixel = 0, Parent = root,
})
new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = tabBar })
local tabIndicator = new("Frame", {
    Size = UDim2.new(1 / #TABS, -6, 0, 3), Position = UDim2.new(0, 3, 1, -3),
    BackgroundColor3 = COL_ACCENT, BorderSizePixel = 0, Parent = tabBar,
})
new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = tabIndicator })

local pages, tabButtons = {}, {}
local crosshair, fovCircle, bubble

local function switchTab(i)
    for idx, p in pairs(pages) do p.Visible = (idx == i) end
    for idx, b in pairs(tabButtons) do tw(b, { TextColor3 = (idx == i) and COL_TEXT or COL_SUB }, 0.15) end
    tw(tabIndicator, { Position = UDim2.new((i - 1) / #TABS, 3, 1, -3) }, 0.22)
end

for i, name in ipairs(TABS) do
    local b = new("TextButton", {
        Size = UDim2.new(1 / #TABS, 0, 1, 0), Position = UDim2.fromScale((i - 1) / #TABS, 0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = name,
        TextColor3 = COL_SUB, TextSize = 9, Parent = tabBar,
    })
    b.MouseButton1Click:Connect(function() switchTab(i) end)
    tabButtons[i] = b

    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -138), Position = UDim2.fromOffset(8, 88),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = COL_ACCENT, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = root, Visible = (i == 1),
    })
    new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), Parent = page })
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = page })
    pages[i] = page
end

local function section(parent, text)
    return new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = "▍" .. text, TextColor3 = COL_ACCENT, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = parent,
    })
end

local function toggle(parent, title, desc, default, cb)
    local holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = COL_PANEL,
        BorderSizePixel = 0, Parent = parent,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = holder })
    local stroke = new("UIStroke", { Color = Color3.fromRGB(40, 43, 54), Thickness = 1, Parent = holder })
    new("TextLabel", {
        Size = UDim2.new(1, -58, 0, desc and 15 or 40), Position = UDim2.fromOffset(10, desc and 6 or 0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = title, TextColor3 = COL_TEXT,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
    })
    if desc then
        new("TextLabel", {
            Size = UDim2.new(1, -58, 0, 12), Position = UDim2.fromOffset(10, 21),
            BackgroundTransparency = 1, Font = Enum.Font.Gotham, Text = desc, TextColor3 = COL_SUB,
            TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
        })
    end
    local pill = new("Frame", {
        Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(35, 38, 47), BorderSizePixel = 0, Parent = holder,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = pill })
    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.fromRGB(120, 124, 138), BorderSizePixel = 0, Parent = pill,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local on = false
    local function set(v, silent)
        on = v
        tw(knob, {
            Position = UDim2.fromOffset(v and 20 or 2, 2),
            BackgroundColor3 = v and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 124, 138),
        }, 0.16)
        tw(pill, { BackgroundColor3 = v and COL_ACCENT or Color3.fromRGB(35, 38, 47) }, 0.16)
        tw(stroke, { Color = v and COL_ACCENT or Color3.fromRGB(40, 43, 54), Transparency = v and 0.4 or 0 }, 0.16)
        if not silent and cb then task.spawn(cb, v) end
    end

    local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = holder })
    btn.MouseButton1Click:Connect(function() set(not on) end)
    if default then set(true, true) end
    return set
end

local function slider(parent, title, min, max, default, cb)
    local holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = COL_PANEL, BorderSizePixel = 0, Parent = parent,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = holder })
    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 16), Position = UDim2.fromOffset(10, 5),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = title, TextColor3 = COL_TEXT,
        TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
    })
    local val = new("TextLabel", {
        Size = UDim2.fromOffset(56, 16), Position = UDim2.new(1, -66, 0, 5),
        BackgroundTransparency = 1, Font = Enum.Font.Code, Text = tostring(default),
        TextColor3 = COL_ACCENT, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Parent = holder,
    })
    local track = new("Frame", {
        Size = UDim2.new(1, -20, 0, 5), Position = UDim2.fromOffset(10, 28),
        BackgroundColor3 = Color3.fromRGB(33, 36, 45), BorderSizePixel = 0, Parent = holder,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
    local fill = new("Frame", {
        Size = UDim2.fromScale((default - min) / (max - min), 1),
        BackgroundColor3 = COL_ACCENT, BorderSizePixel = 0, Parent = track,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

    local dragS = false
    local function setFromX(px)
        local rel = math.clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.fromScale(rel, 1)
        val.Text = tostring(v)
        cb(v)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragS = true
            setFromX(i.Position.X)
        end
    end)
    conn(UserInputService.InputChanged, function(i)
        if dragS and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    conn(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragS = false
        end
    end)
    cb(default)
end

local function button(parent, text, cb, color)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = color or Color3.fromRGB(28, 31, 40),
        BorderSizePixel = 0, Font = Enum.Font.GothamBold, Text = text, TextColor3 = COL_TEXT,
        TextSize = 11, AutoButtonColor = false, Parent = parent,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = b })
    b.MouseEnter:Connect(function() tw(b, { BackgroundColor3 = COL_ACCENT }, 0.15) end)
    b.MouseLeave:Connect(function() tw(b, { BackgroundColor3 = color or Color3.fromRGB(28, 31, 40) }, 0.15) end)
    b.MouseButton1Click:Connect(function() task.spawn(cb) end)
    return b
end

local function holdButton(parent, text, onDown, onUp, color)
    local b = new("TextButton", {
        Size = UDim2.new(0.5, -3, 0, 38), BackgroundColor3 = color or Color3.fromRGB(28, 31, 40),
        BorderSizePixel = 0, Font = Enum.Font.GothamBold, Text = text, TextColor3 = COL_TEXT,
        TextSize = 12, AutoButtonColor = false, Parent = parent,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = b })
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            onDown()
        end
    end)
    b.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            onUp()
        end
    end)
    return b
end

-- COMBATE
section(pages[1], "CONTROL TOTAL")
toggle(pages[1], "FLY CREEPY 🎃", "Vuela + hitbox gigante + mata a todos solo", false, function(v)
    state.flyCreepy, state.fly = v, v
    if v then
        setHitboxes(true)
        startFly()
        refreshRed()
    else
        stopFly()
        if not state.magicBullets and not state.redAll then setHitboxes(false) end
    end
    notify(v and "FLY CREEPY ON" or "FLY CREEPY OFF", v)
end)
toggle(pages[1], "BALAS MAGICAS", "Hitbox gigante en todos, tu disparo los mata", false, function(v)
    state.magicBullets = v
    if v then setHitboxes(true) else
        if not state.flyCreepy and not state.redAll then setHitboxes(false) end
    end
    notify(v and "Balas Magicas ON" or "Balas Magicas OFF", v)
end)
toggle(pages[1], "TODO ROJO 🔴", "Hitboxes en rojo + mira clavada a la cabeza", false, function(v)
    state.redAll = v
    if v then refreshRed() else clearRed() end
    notify(v and "Todo Rojo ON" or "Todo Rojo OFF", v)
end)
toggle(pages[1], "AUTO SHOOT", "Dispara solo, sin que toques nada", false, function(v)
    state.autoShoot = v
    notify(v and "Auto Shoot ON" or "Auto Shoot OFF", v)
end)
toggle(pages[1], "INVISIBLE", "Te ocultas de la vista", false, function(v)
    state.invisible = v
    setInvisible(v)
    notify(v and "Invisible ON" or "Invisible OFF", v)
end)

section(pages[1], "AJUSTES")
slider(pages[1], "Alcance", 50, 1200, 500, function(v) cfg.shootRange = v end)
slider(pages[1], "Tamano de hitbox", 2, 10, 6, function(v)
    cfg.hitboxScale = v
    if state.flyCreepy or state.magicBullets then
        setHitboxes(false)
        setHitboxes(true)
    end
end)
slider(pages[1], "Cadencia (ms)", 40, 400, 90, function(v) cfg.cadence = v / 1000 end)
toggle(pages[1], "Inyeccion de remotes", "Mas letal, algo mas detectable", false, function(v) state.inject = v end)

